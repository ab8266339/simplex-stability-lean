WeakSimplexGeometry.hessian_reduction_identity (m A B C E0 E1 : ℝ) (hm : 3 ≤ m) :
  have alpha := (m - 1) / m;
  have N := 4 * alpha * E0 + 2 * E1;
  have R := (m - 2) * E1;
  -m * C / 8 * (N - 2 * R / m) + A / 4 * N - (C - B) / 2 * R =
    (alpha * A - (m - 1) * C / 2) * E0 + ((A + (m - 2) * B) / 2 - (m - 1) * C / 2) * E1
WeakSimplexGeometry.hessian_quadratic_pos (m A B C E0 E1 : ℝ) (hm : 3 ≤ m) (hE0 : 0 ≤ E0) (hE1 : 0 ≤ E1)
  (hE : 0 < E0 + E1) (hGap0 : 0 < (m - 1) / m * A - (m - 1) * C / 2)
  (hGap1 : 0 < (A + (m - 2) * B) / 2 - (m - 1) * C / 2) :
  0 <
    have alpha := (m - 1) / m;
    have N := 4 * alpha * E0 + 2 * E1;
    have R := (m - 2) * E1;
    -m * C / 8 * (N - 2 * R / m) + A / 4 * N - (C - B) / 2 * R
WeakSimplexGeometry.hessian_quadratic_pos_m3 (A B C E1 : ℝ) (hE1 : 0 < E1)
  (hGap1 : 0 < (A + (3 - 2) * B) / 2 - (3 - 1) * C / 2) :
  0 <
    have alpha := (3 - 1) / 3;
    have N := 4 * alpha * 0 + 2 * E1;
    have R := (3 - 2) * E1;
    -3 * C / 8 * (N - 2 * R / 3) + A / 4 * N - (C - B) / 2 * R
WeakSimplexGeometry.shell_scalar_relations (m rho : ℝ) (hm : 0 < m) (h0 : 0 ≤ rho ^ 2) (h1 : rho ^ 2 < 2 * m) :
  have kappa := 1 - rho ^ 2 / (2 * m);
  0 < kappa ∧ 2 * m * (1 - kappa) = rho ^ 2 ∧ kappa ^ 2 - 1 = -rho ^ 2 / m + rho ^ 4 / (4 * m ^ 2)
